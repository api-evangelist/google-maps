              "name": "Get Details About a Place",
              "id": "c2c97026-2ba9-438a-a742-2486a2dd6f59",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "description": "(Required) A comma-separated list of place data fields to return. Use field masking to specify which fields to include in the response. For example: places.displayName,places.formattedAddress. Use * to return all fields (not recommended in production).",
                    "key": "X-Goog-FieldMask",
                    "value": "<string>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/places/:placeId?languageCode=<string>&regionCode=<string>&sessionToken=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "places",
                    ":placeId"
                  ],
                  "query": [
                    {
                      "description": "The language code (BCP-47) to use for returning results. If not specified, results may be in mixed languages.",
                      "key": "languageCode",
                      "value": "<string>"
                    },
                    {
                      "description": "The Unicode country/region code (CLDR) of the location where the request is coming from. Used for formatting and biasing.",
                      "key": "regionCode",
                      "value": "<string>"
                    },
                    {
                      "description": "A random string that groups an autocomplete session for billing. The session begins with an autocomplete request and concludes with a place details or address validation call.",
                      "key": "sessionToken",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "id": "adaef33e-f47e-48ba-80f6-f2c9e2f2dd93",
                      "key": "placeId",
                      "value": "<string>",
                      "description": "(Required) The resource name of a place in the format places/{placeId}."
                    }
                  ]
                },
                "description": "Returns detailed information about a place identified by its resource name. Use the fieldMask parameter to specify which fields to return. Only fields specified in the field mask are returned; requesting fewer fields reduces cost and improves performance."
