{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Viewport",
  "title": "Viewport",
  "type": "object",
  "description": "A rectangular viewport defined by two diagonally opposite points",
  "properties": {
    "low": {
      "$ref": "#/components/schemas/LatLng"
    },
    "high": {
      "$ref": "#/components/schemas/LatLng"
    }
  },
  "required": [
    "low",
    "high"
  ]
}