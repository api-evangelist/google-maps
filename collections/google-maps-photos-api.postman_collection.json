      "id": "90afd927-f388-430e-8d0c-845fff51f9e1",
      "name": "Photos",
      "description": {
        "content": "Access photos associated with places",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4e792e4d-33ca-4d2f-a834-f22055b3db2a",
          "name": "Get a Place Photo",
          "request": {
            "name": "Get a Place Photo",
            "description": {
              "content": "Returns a photo for a place. After you get the photo resource name from a Place Details or Search response, use this endpoint to get the photo bytes. Specify maxHeightPx or maxWidthPx (or both) to control the image dimensions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "places",
                ":placeId",
                "photos",
                ":photoReference",
                "media"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "maxHeightPx",
                  "value": "<integer>",
                  "description": "Maximum height of the image in pixels. Must be between 1 and 4800. If maxHeightPx is set without maxWidthPx, the image is resized to the specified height, preserving aspect ratio."
                },
                {
                  "disabled": false,
                  "key": "maxWidthPx",
                  "value": "<integer>",
                  "description": "Maximum width of the image in pixels. Must be between 1 and 4800. If maxWidthPx is set without maxHeightPx, the image is resized to the specified width, preserving aspect ratio."
                },
                {
                  "disabled": false,
                  "key": "skipHttpRedirect",
                  "value": "false",
                  "description": "If set to true, skip the default HTTP redirect behavior and return a JSON response containing the photo URI."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "placeId",
                  "description": "(Required) The place ID"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "photoReference",
                  "description": "(Required) The photo resource reference"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/*"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "8955624f-d3ae-4da8-9ce4-ae0d90fe6050",
