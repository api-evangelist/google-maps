{
  "opencollection": "1.0.0",
  "info": {
    "name": "Google Maps Directions Autocomplete API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Autocomplete",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Place Autocomplete Predictions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://maps.googleapis.com/maps/api/places:autocomplete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns predictions for the given input text. Predictions include place predictions and query predictions. Use session tokens to group autocomplete requests for billing purposes."
        }
      ]
    }
  ],
  "bundled": true
}