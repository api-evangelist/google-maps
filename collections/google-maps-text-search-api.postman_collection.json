                  "raw": "{\n  \"textQuery\": \"example_value\",\n  \"includedType\": \"example_value\",\n  \"languageCode\": \"example_value\",\n  \"regionCode\": \"example_value\",\n  \"rankPreference\": \"RELEVANCE\",\n  \"maxResultCount\": 10,\n  \"locationBias\": {},\n  \"locationRestriction\": {},\n  \"priceLevels\": [\n    \"PRICE_LEVEL_INEXPENSIVE\"\n  ],\n  \"openNow\": true,\n  \"minRating\": 42.5,\n  \"strictTypeFiltering\": true\n}",
